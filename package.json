{
  "name": "scn-food-order-builder",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "node --import ./tools/ts-resolver.mjs server/index.ts",
    "build": "ng build",
    "test": "node --import ./tools/ts-resolver.mjs --test src/shared/**/*.test.ts server/**/*.test.ts",
    "test:watch": "node --import ./tools/ts-resolver.mjs --test --watch src/shared/**/*.test.ts server/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "serve:api": "node --import ./tools/ts-resolver.mjs server/index.ts",
    "build:client": "ng build",
    "test:e2e": "node tools/smoke.mjs",
    "start:dev": "ng serve",
    "local": "npm run build:client && npm start"
  },
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}

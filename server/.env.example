# Copy to .env and fill in. Values shown are safe local defaults.

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delivery_tracking
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Used by `npm test`. Must be a DIFFERENT database: the suite truncates it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/delivery_tracking_test

# --- Auth ------------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- URLs ------------------------------------------------------------------
# Where the React app is served from; used to build customer tracking links.
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=*

# --- CSV import ------------------------------------------------------------
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=5000

# --- Proof-of-delivery storage ---------------------------------------------
# local  = write to ./var/uploads and serve via the API (default; no account needed)
# s3     = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
# memory = keep in process memory (tests only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
# How long a generated proof-of-delivery link stays valid.
STORAGE_URL_TTL_SECONDS=604800

# S3-compatible settings (only read when STORAGE_DRIVER=s3)
S3_BUCKET=delivery-proof-of-delivery
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=PLACEHOLDER_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=PLACEHOLDER_SECRET_ACCESS_KEY
# Set for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Customer notifications -------------------------------------------------
# log     = write the message to the server log instead of sending (default)
# live    = actually send via Twilio / SendGrid
# disabled = record as skipped, send nothing
NOTIFICATIONS_DRIVER=log
NOTIFY_ON_STATUSES=ready_for_delivery,out_for_delivery,delivered,failed_attempt

# Twilio (SMS) — placeholders; swap in real credentials to go live
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=PLACEHOLDER_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15550000000

# SendGrid (email) — placeholders; swap in real credentials to go live
SENDGRID_API_KEY=SG.PLACEHOLDER_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=deliveries@example.com
SENDGRID_FROM_NAME=Deliveries
